{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "commonjs",
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"removeComments": false,
		"sourceMap": false,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
