{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.mts"],
	"exclude": ["test/typings"]
}
