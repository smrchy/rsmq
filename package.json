{
  "name": "rsmq",
  "description": "A really simple message queue based on Redis",
  "version": "1.0.0-beta.0",
  "license": "MIT",
  "author": "P. Liess <smrchy+npm@gmail.com>",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json",
    "test:types": "tsc -p ./test/typings",
    "pretest": "npm run build && npm run typecheck && npm run test:types",
    "test": "node --test --test-concurrency=1 \"test/*.test.mts\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "queue",
    "messagequeue",
    "jobs",
    "message-queue",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smrchy/rsmq.git"
  },
  "bugs": {
    "url": "https://github.com/smrchy/rsmq/issues"
  },
  "homepage": "https://github.com/smrchy/rsmq#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ]
}
