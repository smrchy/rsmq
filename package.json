{
  "name": "rsmq",
  "description": "A really simple message queue based on Redis",
  "version": "0.13.0",
  "license": "MIT",
  "author": "P. Liess <smrchy+npm@gmail.com>",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "coffee -c -o ./test ./test/test.coffee",
    "watch": "tsc -w",
    "test:types": "tsc -p ./test/typings",
    "pretest": "npm run build && npm run build:test && npm run test:types",
    "test": "mocha ./test/test.js"
  },
  "dependencies": {
    "redis": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/redis": "^2.8.32",
    "async": "^3.2.6",
    "coffeescript": "^2.7.0",
    "mocha": "^11.7.4",
    "should": "^13.2.3",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "queue",
    "messagequeue",
    "jobs",
    "message-queue",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/smrchy/rsmq.git"
  },
  "bugs": {
    "url": "https://github.com/smrchy/rsmq/issues"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ]
}
